# Admin panel password (prototype). Change before any real deployment.
ADMIN_PASSWORD=classfind-demo

# Secret used to sign the admin session cookie. Use a long random value.
AUTH_SECRET=

# Optional: override where the SQLite database file is created.
# CLASSFIND_DB_PATH=C:\absolute\path\classfind.db

# ---- Email delivery (invite link goes to the student's email) ----
# FREE via the Resend free tier (3,000 emails/month). Without these vars the
# email is simulated so the prototype still demonstrates the full flow.
# RESEND_API_KEY=re_xxxxxxxxxxxx
# EMAIL_FROM=CLASSFIND <onboarding@yourdomain.com>

# ---- SMS OTP delivery (code goes to the student's registered mobile) ----
# Configure exactly ONE provider. Without one, the OTP is simulated and shown
# on-screen (demo mode).
# SMS_PROVIDER=fast2sms          # or: msg91 | twilio
# FAST2SMS_API_KEY=xxxxxxxxxxxx
# --- CHEAP route (₹0.25/msg, no DLT): Fast2SMS "Smart OTP" with WhatsApp as
#     primary channel. Create an OTP template in their Smart OTP panel (Meta
#     template approval ~24h), copy the OTP ID, set it here.
# FAST2SMS_OTP_ID=xxxxxxxxxxxx
# --- Alternative cheap route (₹0.25/SMS): DLT SMS. Needs DLT registration +
#     approved template. Set sender + template id to switch off the ₹5 Quick
#     route. Fast2SMS provides free DLT support.
# FAST2SMS_SENDER=CLSSFN         # 6-char approved sender ID
# FAST2SMS_TEMPLATE_ID=xxxxxxxxxxxx
# MSG91_AUTH_KEY=xxxxxxxxxxxx
# MSG91_TEMPLATE_ID=xxxxxxxxxxxx
# TWILIO_ACCOUNT_SID=xxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxx
# TWILIO_FROM=+1xxxxxxxxxx